# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environment ────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Distribution / packaging ───────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.cover
coverage.xml
nosetests.xml
test-results/

# ── Runtime logs & generated data ────────────────────────────────────────────
*.log
*.csv
validate_layer/override_log.csv
validate_layer/override_log.txt
# Keep the committed blank/template logs if any exist, but ignore generated ones.
# If you want to track a specific CSV template, use: git add -f <file>

# ── IDE & editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Type checker / linter caches ─────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytype/

# ── Secrets / environment variables ──────────────────────────────────────────
.env
.env.*
*.pem
*.key
.pip_tmp/
